# ==============================================================================
# AssetBridge SaaS - Production Environment Configuration
# ==============================================================================

# Application & Security
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="AssetBridge SaaS"
API_V1_STR="/api/v1"

# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-ultra-secure-random-secret-key-in-production-min32chars

# Master 256-bit encryption key for partner API credentials at rest (64 hex characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword2026@localhost:5432/assetbridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword2026
POSTGRES_DB=assetbridge

# Redis & Celery
REDIS_URL=redis://:redispassword2026@localhost:6379/0
CELERY_BROKER_URL=redis://:redispassword2026@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redispassword2026@localhost:6379/2

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword123
S3_BUCKET_NAME=assetbridge-downloads
S3_REGION=us-east-1

# Parallel Streaming Engine Settings
MAX_PARALLEL_CHUNKS=16
CHUNK_SIZE_BYTES=2097152
DOWNLOAD_TIMEOUT_SECONDS=300
METADATA_CACHE_TTL_SECONDS=600

# Rate Limiting
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_PARTNER_BURST=30

# Partner 1: Magnific AI Enterprise
MAGNIFIC_API_KEY=mag_live_enterprise_auth_token_secret
MAGNIFIC_API_URL=https://api.magnific.ai/v1

# Partner 2: Motion Array Enterprise
MOTIONARRAY_CLIENT_ID=ma_partner_client_id_live
MOTIONARRAY_CLIENT_SECRET=ma_partner_client_secret_live
MOTIONARRAY_API_URL=https://api.motionarray.com/v1

# Partner 3: Envato Elements & Market
ENVATO_API_TOKEN=envato_bearer_token_commercial_v3
ENVATO_API_URL=https://api.envato.com/v1

# Partner 4: Freepik Enterprise
FREEPIK_API_KEY=fpk_api_key_corporate_license
FREEPIK_API_URL=https://api.freepik.com/v1

# Partner 5: Storyblocks Enterprise
STORYBLOCKS_PUBLIC_KEY=sb_pub_key_enterprise
STORYBLOCKS_PRIVATE_KEY=sb_priv_hmac_secret_key
STORYBLOCKS_API_URL=https://api.storyblocks.com/api/v2

# Partner 6: Artgrid / Artlist Cinema
ARTGRID_API_KEY=artgrid_cinema_pro_token
ARTGRID_API_URL=https://api.artgrid.io/v1

# Frontend App Config
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CAPACITOR_SERVER_URL=https://app.assetbridge.io

